# Copy to .env and fill in before building for production.

# Public URL of the website (no trailing slash). Used for canonical URLs,
# Open Graph/Twitter image URLs, structured data and sitemap.xml.
# Leave empty until the domain is confirmed — sitemap.xml is skipped then.
VITE_SITE_URL=https://imrgroups.in

# Optional: HTTPS endpoint that accepts enquiry form submissions as JSON
# (your CRM, a serverless function, or a form service). When empty, the
# enquiry form hands the visitor over to WhatsApp instead. See README.md.
VITE_LEAD_ENDPOINT=
